# ===================================================
# YAQIN - DEVELOPMENT CONFIGURATION
# ===================================================
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (Development: SQLite)
DATABASE_URL="file:./dev.db"

# Telegram Bot
TELEGRAM_BOT_TOKEN="dev_mock_token"
TELEGRAM_BOT_USERNAME="yaqin_dating_bot"
TELEGRAM_WEBHOOK_SECRET="dev-webhook-secret-12345"
ADMIN_TELEGRAM_IDS="100000001"

# Security
JWT_SECRET="yaqin-dev-secret-key-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# URLs
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:5174"

# Storage
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"

# Payment
PAYMENT_PROVIDER="mock"
PAYMENT_SECRET="dev-payment-secret"

# Moderation
MODERATION_ENABLED="false"
MODERATION_API_KEY=""

# Admin Seed
ADMIN_DEFAULT_EMAIL="admin@yaqin.uz"
ADMIN_DEFAULT_PASSWORD="SuperSecureAdminPassword123!"
