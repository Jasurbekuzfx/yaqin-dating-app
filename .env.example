# ===================================================
# YAQIN TELEGRAM DATING PLATFORM - ENVIRONMENT CONFIG
# ===================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL / SQLite for development)
# For Postgres: postgresql://postgres:postgres@localhost:5432/yaqin_db?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/yaqin_db?schema=public"

# Telegram Integration
TELEGRAM_BOT_TOKEN="123456789:ABCDefghIJKlmNoPQRsTUVwxyZ"
TELEGRAM_BOT_USERNAME="yaqin_dating_bot"
TELEGRAM_WEBHOOK_SECRET="super-secret-webhook-key-here"

# Security & Sessions
JWT_SECRET="yaqin-ultra-secure-jwt-secret-min-32-chars-long"
JWT_EXPIRES_IN="7d"

# URLs
APP_URL="http://localhost:5173"
API_URL="http://localhost:4000"
ADMIN_URL="http://localhost:5174"

# Storage (S3 / Local abstraction)
STORAGE_DRIVER="local" # "local" or "s3"
UPLOAD_DIR="./uploads"
S3_ENDPOINT="https://s3.amazonaws.com"
S3_ACCESS_KEY="s3-access-key-example"
S3_SECRET_KEY="s3-secret-key-example"
S3_BUCKET="yaqin-media"
S3_REGION="us-east-1"

# Payments (Telegram Stars & Mock Provider)
PAYMENT_PROVIDER="stars" # "stars" or "mock"
PAYMENT_SECRET="payment-provider-webhook-secret"

# Content Moderation
MODERATION_API_KEY="mock-or-external-moderation-key"
MODERATION_ENABLED="false"

# Admin Initial Credentials (Seed only)
ADMIN_DEFAULT_EMAIL="admin@yaqin.uz"
ADMIN_DEFAULT_PASSWORD="SuperSecureAdminPassword123!"
