# ===================================================
# YAQIN - PRODUCTION CONFIGURATION
# ===================================================
NODE_ENV=production
PORT=4000
HOST=0.0.0.0

# Database (Production Managed PostgreSQL / Supabase / Neon / AWS RDS)
DATABASE_URL="postgresql://postgres:PRODUCTION_STRONG_PASSWORD@prod-db.yaqin.uz:5432/yaqin_prod?schema=public&sslmode=require"

# Telegram Bot (Real Production BotFather Token)
TELEGRAM_BOT_TOKEN="REAL_BOT_TOKEN_FROM_BOTFATHER"
TELEGRAM_BOT_USERNAME="yaqin_dating_bot"
TELEGRAM_WEBHOOK_SECRET="GENERATE_HIGH_ENTROPY_64_CHAR_SECRET"
ADMIN_TELEGRAM_IDS="YOUR_REAL_TELEGRAM_ID"

# Security (Strict min 32-64 char high-entropy JWT Secret)
JWT_SECRET="GENERATE_STRONG_RANDOM_SECRET_KEY_MIN_64_CHARS"
JWT_EXPIRES_IN="7d"

# URLs (Must be HTTPS in Production)
APP_URL="https://app.yaqin.uz"
API_URL="https://api.yaqin.uz"
ADMIN_URL="https://admin.yaqin.uz"

# Storage (Production S3 / Cloudflare R2)
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://s3.amazonaws.com"
S3_ACCESS_KEY="PROD_S3_ACCESS_KEY"
S3_SECRET_KEY="PROD_S3_SECRET_KEY"
S3_BUCKET="yaqin-prod-media"
S3_REGION="eu-central-1"

# Payments (Production Telegram Stars / Click / Payme)
PAYMENT_PROVIDER="stars"
PAYMENT_SECRET="PROD_PAYMENT_WEBHOOK_SECRET"

# Content Moderation (Automated NSFW & Safety API)
MODERATION_ENABLED="true"
MODERATION_API_KEY="PROD_SIGHTENGINE_OR_OPENAI_KEY"

# SuperAdmin Initial Password (Seed only - Must be changed upon first login)
ADMIN_DEFAULT_EMAIL="admin@yaqin.uz"
ADMIN_DEFAULT_PASSWORD="CHANGE_THIS_TO_STRONG_PASSWORD_ON_BOOTSTRAP"
