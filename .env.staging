# ===================================================
# YAQIN - STAGING CONFIGURATION
# ===================================================
NODE_ENV=staging
PORT=4000
HOST=0.0.0.0

# Database (PostgreSQL Staging)
DATABASE_URL="postgresql://yaqin_staging_user:staging_password@staging-db.yaqin.uz:5432/yaqin_staging?schema=public"

# Telegram Bot (Staging Test Bot)
TELEGRAM_BOT_TOKEN="staging_bot_token_from_botfather"
TELEGRAM_BOT_USERNAME="yaqin_test_bot"
TELEGRAM_WEBHOOK_SECRET="staging-webhook-secret-key-9988"
ADMIN_TELEGRAM_IDS="YOUR_TELEGRAM_ID"

# Security
JWT_SECRET="yaqin-staging-secret-key-minimum-32-chars-long"
JWT_EXPIRES_IN="7d"

# URLs (Staging HTTPS)
APP_URL="https://staging.yaqin.uz"
API_URL="https://api-staging.yaqin.uz"
ADMIN_URL="https://admin-staging.yaqin.uz"

# Storage (S3 / R2)
STORAGE_DRIVER="s3"
S3_ENDPOINT="https://s3.amazonaws.com"
S3_ACCESS_KEY="staging-s3-key"
S3_SECRET_KEY="staging-s3-secret"
S3_BUCKET="yaqin-staging-media"
S3_REGION="eu-central-1"

# Payment (Telegram Stars Test Mode)
PAYMENT_PROVIDER="stars"
PAYMENT_SECRET="staging-payment-secret"

# Moderation
MODERATION_ENABLED="true"
MODERATION_API_KEY="staging-moderation-key"

ADMIN_DEFAULT_EMAIL="admin-staging@yaqin.uz"
ADMIN_DEFAULT_PASSWORD="SetStrongPasswordHere"
