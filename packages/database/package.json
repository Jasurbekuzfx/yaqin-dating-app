{
  "name": "@yaqin/database",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "generate:pg": "prisma generate --schema=prisma/schema.postgres.prisma",
    "push": "prisma db push",
    "push:pg": "prisma db push --schema=prisma/schema.postgres.prisma",
    "migrate": "prisma migrate dev",
    "seed": "tsx src/seed.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1"
  },
  "devDependencies": {
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
